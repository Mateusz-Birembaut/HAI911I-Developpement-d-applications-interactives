#version 430 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Particle structure with std430 alignment
struct Particle {
    vec3 pos;       // 12 bytes + 4 bytes padding = 16 bytes
    float age;      // 4 bytes
    vec3 speed;     // 12 bytes + 4 bytes padding = 16 bytes
    float ageMax;   // 4 bytes
};

// Shader Storage Buffer Object for particles
layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

// Uniforms
uniform float deltaTime;
uniform float time;

// Constants
const float PI = 3.14159265359;
const float GRAVITY = 9.8;

// Simple random function based on particle index and time
float random(uint seed) {
    return fract(sin(float(seed) * 12.9898 + time * 78.233) * 43758.5453);
}

// Initialize a particle
void initParticle(uint index) {
    float angle = 2.0 * PI * random(index * 2);
    float horizontalSpeed = 1.0 + 2.0 * random(index * 3);
    float verticalSpeed = 3.0 + 5.0 * random(index * 5);
    
    particles[index].pos = vec3(0.0, 0.0, 0.0);
    particles[index].speed = vec3(
        horizontalSpeed * cos(angle),
        horizontalSpeed * sin(angle),
        verticalSpeed
    );
    particles[index].age = 0.0;
    particles[index].ageMax = 50.0 + 100.0 * random(index * 7);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    
    // Check bounds
    if (index >= particles.length()) {
        return;
    }
    
    // Limit deltaTime to avoid large jumps
    float dt = min(deltaTime, 0.1);
    
    // Apply gravity on Z axis (downward)
    particles[index].speed.z -= GRAVITY * dt;
    
    // Update position
    particles[index].pos += particles[index].speed * dt;
    
    // Handle collision with ground
    if (particles[index].pos.z < 0.0) {
        particles[index].speed.z = -0.8 * particles[index].speed.z;
        particles[index].pos.z = 0.0;
    }
    
    // Update age
    particles[index].age += dt;
    
    // Reinitialize if too old
    if (particles[index].age >= particles[index].ageMax) {
        initParticle(index);
    }
}